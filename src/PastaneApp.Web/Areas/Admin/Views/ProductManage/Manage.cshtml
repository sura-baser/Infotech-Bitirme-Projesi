@using PastaneApp.Core.Enums
@model ProductManageViewModel

@{
    ViewData["Title"] = $"{Model.ProductName} - Detaylar";
}

<h1 class="mb-1">@Model.ProductName</h1>
<a asp-controller="Products" asp-action="Index" class="btn btn-link ps-0 mb-4">&larr; Ürün Listesine Dön</a>

<div class="row">
    <div class="col-md-6 mb-4">
        <h4>Fotoğraflar</h4>
        <table class="table table-sm">
            <thead>
                <tr><th>Önizleme</th><th>Tür</th><th>Sıra</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var image in Model.Images)
                {
                    <tr>
                        <td><img src="@image.ImageUrl" alt="" style="width:60px;height:60px;object-fit:cover;" class="rounded" /></td>
                        <td>@image.ImageType</td>
                        <td>@image.SortOrder</td>
                        <td>
                            <form asp-action="DeleteImage" method="post" class="d-inline">
                                <input type="hidden" name="imageId" value="@image.Id" />
                                <input type="hidden" name="productId" value="@Model.ProductId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <form asp-action="AddImage" method="post" class="border rounded p-3">
            <input type="hidden" name="productId" value="@Model.ProductId" />
            <div class="mb-2">
                <label class="form-label">Fotoğraf URL</label>
                <input type="text" name="imageUrl" class="form-control" required />
            </div>
            <div class="mb-2">
                <label class="form-label">Tür</label>
                <select name="imageType" class="form-select">
                    <option value="@ImageType.Finished">Bitmiş Ürün</option>
                    <option value="@ImageType.Ingredients">İçindekiler</option>
                    <option value="@ImageType.Process">Oluşum</option>
                </select>
            </div>
            <div class="mb-2">
                <label class="form-label">Sıra</label>
                <input type="number" name="sortOrder" class="form-control" value="0" />
            </div>
            <button type="submit" class="btn btn-primary btn-sm">+ Fotoğraf Ekle</button>
        </form>
    </div>

    <div class="col-md-6 mb-4">
        <h4>Malzemeler</h4>
        <ul class="list-group mb-3">
            @foreach (var ingredient in Model.Ingredients)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    @ingredient.Name
                    <form asp-action="DeleteIngredient" method="post" class="d-inline">
                        <input type="hidden" name="ingredientId" value="@ingredient.Id" />
                        <input type="hidden" name="productId" value="@Model.ProductId" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                    </form>
                </li>
            }
        </ul>

        <form asp-action="AddIngredient" method="post" class="d-flex gap-2 mb-4">
            <input type="hidden" name="productId" value="@Model.ProductId" />
            <input type="hidden" name="sortOrder" value="@Model.Ingredients.Count" />
            <input type="text" name="name" class="form-control" placeholder="Örn: Mascarpone" required />
            <button type="submit" class="btn btn-primary btn-sm text-nowrap">+ Ekle</button>
        </form>

        <h4>Alerjenler</h4>
        <form asp-action="UpdateAllergens" method="post">
            <input type="hidden" name="productId" value="@Model.ProductId" />
            @foreach (var allergen in Model.AllAllergens)
            {
                <div class="form-check">
                    <input type="checkbox" name="allergenIds" value="@allergen.Id" class="form-check-input"
                           id="allergen-@allergen.Id" checked="@Model.SelectedAllergenIds.Contains(allergen.Id)" />
                    <label class="form-check-label" for="allergen-@allergen.Id">@allergen.Name</label>
                </div>
            }
            <button type="submit" class="btn btn-primary btn-sm mt-2">Alerjenleri Kaydet</button>
        </form>
    </div>
</div>
