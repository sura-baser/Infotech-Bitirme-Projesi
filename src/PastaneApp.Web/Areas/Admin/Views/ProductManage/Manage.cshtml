@using PastaneApp.Core.Enums
@model ProductManageViewModel

@{
    ViewData["Title"] = $"{Model.ProductName} - Detaylar";
}

<h1 class="as-serif" style="font-size:28px; font-weight:700; margin:0 0 8px;">@Model.ProductName</h1>
<a asp-controller="Products" asp-action="Index" style="font-size:14px; color:var(--ink-soft); display:inline-block; margin-bottom:28px;">&larr; Ürün Listesine Dön</a>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:start;">
    <div>
        <div style="font-size:13px; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-soft); font-weight:600; margin-bottom:16px;">Fotoğraflar</div>

        @if (Model.Images.Any())
        {
            <div style="display:flex; flex-direction:column; gap:12px; margin-bottom:20px;">
                @foreach (var image in Model.Images)
                {
                    <div style="display:flex; align-items:center; gap:14px; background:#fff; border:1px solid var(--line); padding:10px 14px;">
                        <img src="@image.ImageUrl" alt="" style="width:52px; height:52px; object-fit:cover;" />
                        <div style="flex:1; font-size:14px;">@image.ImageType</div>
                        <div style="font-size:13px; color:var(--ink-soft);">Sıra: @image.SortOrder</div>
                        <form asp-action="DeleteImage" method="post">
                            <input type="hidden" name="imageId" value="@image.Id" />
                            <input type="hidden" name="productId" value="@Model.ProductId" />
                            <button type="submit" style="border:none; background:transparent; color:#B3261E; font-size:13px; cursor:pointer;">Sil</button>
                        </form>
                    </div>
                }
            </div>
        }

        <form asp-action="AddImage" method="post" style="border:1px solid var(--line); padding:20px; background:#fff;">
            <input type="hidden" name="productId" value="@Model.ProductId" />
            <div style="margin-bottom:14px;">
                <label style="display:block; font-size:14px; margin-bottom:8px;">Fotoğraf URL</label>
                <input type="text" name="imageUrl" required style="width:100%; padding:10px 14px; border:1px solid var(--line); font-size:14px;" />
            </div>
            <div style="margin-bottom:14px;">
                <label style="display:block; font-size:14px; margin-bottom:8px;">Tür</label>
                <select name="imageType" class="form-select" style="border-radius:0; border-color:var(--line);">
                    <option value="@ImageType.Finished">Bitmiş Ürün</option>
                    <option value="@ImageType.Ingredients">İçindekiler</option>
                    <option value="@ImageType.Process">Oluşum</option>
                </select>
            </div>
            <div style="margin-bottom:16px;">
                <label style="display:block; font-size:14px; margin-bottom:8px;">Sıra</label>
                <input type="number" name="sortOrder" value="0" style="width:100%; padding:10px 14px; border:1px solid var(--line); font-size:14px;" />
            </div>
            <button type="submit" class="as-pill" style="padding:11px 20px; font-size:12px;">+ Fotoğraf Ekle</button>
        </form>
    </div>

    <div>
        <div style="font-size:13px; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-soft); font-weight:600; margin-bottom:16px;">Malzemeler</div>

        @if (Model.Ingredients.Any())
        {
            <div style="display:flex; flex-direction:column; gap:10px; margin-bottom:16px;">
                @foreach (var ingredient in Model.Ingredients)
                {
                    <div style="display:flex; justify-content:space-between; align-items:center; background:#fff; border:1px solid var(--line); padding:10px 14px; font-size:14px;">
                        @ingredient.Name
                        <form asp-action="DeleteIngredient" method="post">
                            <input type="hidden" name="ingredientId" value="@ingredient.Id" />
                            <input type="hidden" name="productId" value="@Model.ProductId" />
                            <button type="submit" style="border:none; background:transparent; color:#B3261E; font-size:13px; cursor:pointer;">Sil</button>
                        </form>
                    </div>
                }
            </div>
        }

        <form asp-action="AddIngredient" method="post" style="display:flex; gap:10px; margin-bottom:36px;">
            <input type="hidden" name="productId" value="@Model.ProductId" />
            <input type="hidden" name="sortOrder" value="@Model.Ingredients.Count" />
            <input type="text" name="name" placeholder="Örn: Mascarpone" required style="flex:1; padding:10px 14px; border:1px solid var(--line); font-size:14px;" />
            <button type="submit" class="as-pill" style="padding:11px 20px; font-size:12px; white-space:nowrap;">+ Ekle</button>
        </form>

        <div style="font-size:13px; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-soft); font-weight:600; margin-bottom:16px;">Alerjenler</div>
        <form asp-action="UpdateAllergens" method="post">
            <input type="hidden" name="productId" value="@Model.ProductId" />
            <div style="display:flex; flex-direction:column; gap:10px; margin-bottom:16px;">
                @foreach (var allergen in Model.AllAllergens)
                {
                    <label style="display:flex; align-items:center; gap:9px; font-size:14px; color:var(--ink-soft); cursor:pointer;">
                        <input type="checkbox" name="allergenIds" value="@allergen.Id" checked="@Model.SelectedAllergenIds.Contains(allergen.Id)" style="accent-color:var(--ink); width:15px; height:15px;" />
                        @allergen.Name
                    </label>
                }
            </div>
            <button type="submit" class="as-pill" style="padding:11px 20px; font-size:12px;">Alerjenleri Kaydet</button>
        </form>
    </div>
</div>
