@model IEnumerable<Category>

@{
    ViewData["Title"] = "Kategoriler";
}

<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:32px;">
    <h1 class="as-serif" style="font-size:28px; font-weight:700; margin:0;">Kategoriler</h1>
    <a asp-action="Create" class="as-pill" style="background:var(--turquoise); color:var(--turquoise-deep); font-weight:700;">+ Yeni Kategori</a>
</div>

<div style="background:#fff; border:1px solid var(--line); box-shadow:0 2px 14px rgba(61,43,28,.06);">
    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr style="background:var(--cream);">
                <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:14px 16px;">Ad</th>
                <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:14px 16px;">Açıklama</th>
                <th style="padding:14px 16px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td class="as-serif" style="padding:14px 16px; border-top:1px solid var(--line); font-size:14px; font-weight:700;">@category.Name</td>
                    <td style="padding:14px 16px; border-top:1px solid var(--line); font-size:14px; color:var(--ink-soft);">@category.Description</td>
                    <td style="padding:14px 16px; border-top:1px solid var(--line); text-align:right;">
                        <a asp-action="Edit" asp-route-id="@category.Id" class="btn" style="font-size:12px; font-weight:600; padding:6px 12px; border:1px solid var(--line);">Düzenle</a>
                        <a asp-action="Delete" asp-route-id="@category.Id" class="btn" style="font-size:12px; font-weight:600; padding:6px 12px; border:1px solid var(--line); color:#B3261E;">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
