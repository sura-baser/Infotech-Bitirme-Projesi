@using Microsoft.AspNetCore.Identity
@using PastaneApp.Core.Entities
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = !string.IsNullOrWhiteSpace(currentUser?.FullName) ? currentUser.FullName : User.Identity?.Name;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    bool IsActive(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Paneli</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400..900;1,400..900&family=Work+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/atelier-sura.css" asp-append-version="true" />
    <style>
        .admin-navlink { display:flex; align-items:center; gap:12px; padding:12px 20px; color:#D8C9B4; font-size:14px; text-decoration:none; border-left:2px solid transparent; }
        .admin-navlink.active { background:rgba(255,255,255,.06); color:var(--cream); border-left:2px solid var(--turquoise); }
        .admin-navlink:hover { color:var(--cream); }
    </style>
</head>
<body>
    <div style="width:100%; min-height:100vh; background:var(--cream); display:flex;">

        <!-- sidebar -->
        <div style="width:240px; background:var(--ink); flex-shrink:0; padding:28px 0;">
            <div style="display:flex; align-items:center; gap:8px; padding:0 20px 32px;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M12 3L13.8 9.2L20 11L13.8 12.8L12 19L10.2 12.8L4 11L10.2 9.2L12 3Z" stroke="var(--turquoise)" stroke-width="1.4" stroke-linejoin="round" /></svg>
                <div lang="en" class="as-serif" style="font-size:18px; font-weight:700; letter-spacing:.03em; text-transform:uppercase; color:var(--cream);">Atelier Sura</div>
            </div>
            <div style="font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:#9A8A74; padding:0 20px 10px;">Yönetim</div>
            <a class="admin-navlink @(IsActive("Categories") ? "active" : "")" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.6" /><rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.6" /><rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.6" /><rect x="14" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.6" /></svg>
                Kategoriler
            </a>
            <a class="admin-navlink @(IsActive("Products") || IsActive("ProductManage") ? "active" : "")" asp-area="Admin" asp-controller="Products" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4 7L12 3L20 7L12 11L4 7Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /><path d="M4 7V17L12 21L20 17V7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                Ürünler
            </a>
            <a class="admin-navlink @(IsActive("Orders") ? "active" : "")" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 22" fill="none"><path d="M1 1H4L6.68 14.39C6.88 15.36 7.74 16 8.73 16H18.4C19.36 16 20.2 15.39 20.44 14.46L22.5 6.5H5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                Siparişler
            </a>
            <a class="admin-navlink @(IsActive("Users") ? "active" : "")" asp-area="Admin" asp-controller="Users" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.6" /><path d="M4 21C4 16.6 7.6 14 12 14C16.4 14 20 16.6 20 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                Kullanıcılar
            </a>
            <div style="margin-top:28px; padding:0 20px;">
                <a asp-area="" asp-controller="Home" asp-action="Index" style="font-size:12px; color:#9A8A74; text-decoration:none;">&larr; Siteye Dön</a>
            </div>
        </div>

        <!-- content -->
        <div style="flex:1; padding:40px 48px;">
            <div style="font-size:13px; color:var(--ink-soft); margin-bottom:6px;">Hoş geldin, @displayName</div>
            @if (TempData["Success"] != null)
            {
                <div style="background:var(--ok-bg); color:var(--ok); padding:12px 16px; margin-bottom:20px; font-size:14px;">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div style="background:var(--off-bg); color:var(--off); padding:12px 16px; margin-bottom:20px; font-size:14px;">@TempData["Error"]</div>
            }
            @RenderBody()
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
