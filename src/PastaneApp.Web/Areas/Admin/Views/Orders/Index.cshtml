@using PastaneApp.Web.Helpers
@model IEnumerable<Order>

@{
    ViewData["Title"] = "Siparişler";
}

<h1 class="as-serif" style="font-size:28px; font-weight:700; margin:0 0 28px;">Siparişler</h1>

@if (!Model.Any())
{
    <p style="color:var(--ink-soft);">Henüz sipariş yok.</p>
}
else
{
    <div style="background:#fff; border:1px solid var(--line); box-shadow:0 2px 14px rgba(61,43,28,.06);">
        <table style="width:100%; border-collapse:collapse;">
            <thead>
                <tr style="background:var(--cream);">
                    <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:14px 16px;">#</th>
                    <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:14px 16px;">Müşteri</th>
                    <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:14px 16px;">Tarih</th>
                    <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:14px 16px;">Ödeme</th>
                    <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:14px 16px;">Durum</th>
                    <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:14px 16px;">Toplam</th>
                    <th style="padding:14px 16px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td style="padding:14px 16px; border-top:1px solid var(--line); font-size:14px;">@order.Id</td>
                        <td style="padding:14px 16px; border-top:1px solid var(--line); font-size:14px;">@(order.ApplicationUser?.FullName ?? order.ApplicationUser?.Email)</td>
                        <td style="padding:14px 16px; border-top:1px solid var(--line); font-size:14px;">@order.OrderDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td style="padding:14px 16px; border-top:1px solid var(--line); font-size:14px;"><span style="display:inline-flex; font-size:12px; font-weight:600; padding:4px 10px; @PaymentStatusHelper.GetBadgeStyle(order.PaymentStatus)">@PaymentStatusHelper.GetDisplayName(order.PaymentStatus)</span></td>
                        <td style="padding:14px 16px; border-top:1px solid var(--line); font-size:14px;">@OrderStatusHelper.GetDisplayName(order.Status)</td>
                        <td style="padding:14px 16px; border-top:1px solid var(--line); font-size:14px; font-weight:600;">@order.TotalAmount.ToString("C2")</td>
                        <td style="padding:14px 16px; border-top:1px solid var(--line); text-align:right;">
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn" style="font-size:12px; font-weight:600; padding:6px 12px; border:1px solid var(--line);">Detay</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
