@using PastaneApp.Web.Helpers
@model IEnumerable<Order>

@{
    ViewData["Title"] = "Siparişler";
}

<h1 class="mb-4">Siparişler</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Müşteri</th>
            <th>Tarih</th>
            <th>Durum</th>
            <th>Toplam</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.Id</td>
                <td>@(order.ApplicationUser?.FullName ?? order.ApplicationUser?.Email)</td>
                <td>@order.OrderDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                <td>@OrderStatusHelper.GetDisplayName(order.Status)</td>
                <td>@order.TotalAmount.ToString("C2")</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">Detay</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">Henüz sipariş yok.</p>
}
