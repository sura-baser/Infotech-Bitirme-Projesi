@using PastaneApp.Core.Enums
@using PastaneApp.Web.Helpers
@model Order

@{
    ViewData["Title"] = $"Sipariş #{Model.Id}";
}

<h1 class="mb-4">Sipariş #@Model.Id</h1>

<div class="row mb-4">
    <div class="col-md-6">
        <p><strong>Müşteri:</strong> @(Model.ApplicationUser?.FullName ?? Model.ApplicationUser?.Email)</p>
        <p><strong>Tarih:</strong> @Model.OrderDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
        <p><strong>Teslimat Adresi:</strong> @Model.DeliveryAddress</p>
        <p><strong>Telefon:</strong> @Model.PhoneNumber</p>
    </div>
    <div class="col-md-6">
        <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="d-flex align-items-end gap-2">
            <div class="flex-grow-1">
                <label class="form-label">Durum</label>
                <select name="status" class="form-select">
                    @foreach (OrderStatus status in Enum.GetValues<OrderStatus>())
                    {
                        <option value="@status" selected="@(status == Model.Status)">@OrderStatusHelper.GetDisplayName(status)</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Güncelle</button>
        </form>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Ürün</th>
            <th>Birim Fiyat</th>
            <th>Adet</th>
            <th>Ara Toplam</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderDetails)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.UnitPrice.ToString("C2")</td>
                <td>@item.Quantity</td>
                <td>@((item.UnitPrice * item.Quantity).ToString("C2"))</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Toplam</th>
            <th>@Model.TotalAmount.ToString("C2")</th>
        </tr>
    </tfoot>
</table>

<a asp-action="Index" class="btn btn-link">&larr; Sipariş Listesine Dön</a>
