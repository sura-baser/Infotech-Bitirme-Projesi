@model IEnumerable<UserListItemViewModel>

@{
    ViewData["Title"] = "Kullanıcılar";
}

<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:32px;">
    <h1 class="as-serif" style="font-size:28px; font-weight:700; margin:0;">Kullanıcılar</h1>
    <a asp-action="Create" class="as-pill" style="background:var(--turquoise); color:var(--turquoise-deep); font-weight:700;">+ Yeni Kullanıcı</a>
</div>

<div style="background:#fff; border:1px solid var(--line); box-shadow:0 2px 14px rgba(61,43,28,.06); overflow-x:auto;">
    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr style="background:var(--cream);">
                <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:14px 16px;">Ad Soyad</th>
                <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:14px 16px;">E-posta</th>
                <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:14px 16px;">Telefon</th>
                <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:14px 16px;">Rol</th>
                <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:14px 16px;">Sipariş</th>
                <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:14px 16px;">Durum</th>
                <th style="padding:14px 16px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td class="as-serif" style="padding:14px 16px; border-top:1px solid var(--line); font-size:14px; font-weight:700;">
                        @(string.IsNullOrWhiteSpace(user.FullName) ? "-" : user.FullName)
                        @if (user.IsCurrentUser)
                        {
                            <span style="font-family:'Work Sans',sans-serif; font-size:11px; font-weight:600; color:var(--ink-soft);"> (siz)</span>
                        }
                    </td>
                    <td style="padding:14px 16px; border-top:1px solid var(--line); font-size:14px;">@user.Email</td>
                    <td style="padding:14px 16px; border-top:1px solid var(--line); font-size:14px; color:var(--ink-soft);">@(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "-" : user.PhoneNumber)</td>
                    <td style="padding:14px 16px; border-top:1px solid var(--line); font-size:14px;">@user.Role</td>
                    <td style="padding:14px 16px; border-top:1px solid var(--line); font-size:14px;">@user.OrderCount</td>
                    <td style="padding:14px 16px; border-top:1px solid var(--line);">
                        @if (user.IsLocked)
                        {
                            <span style="display:inline-flex; font-size:12px; font-weight:600; padding:5px 12px; background:var(--off-bg); color:var(--off);">Kilitli</span>
                        }
                        else
                        {
                            <span style="display:inline-flex; font-size:12px; font-weight:600; padding:5px 12px; background:var(--ok-bg); color:var(--ok);">Aktif</span>
                        }
                    </td>
                    <td style="padding:14px 16px; border-top:1px solid var(--line); text-align:right; white-space:nowrap;">
                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn" style="font-size:12px; font-weight:600; padding:6px 12px; border:1px solid var(--line);">Düzenle</a>
                        @if (!user.IsCurrentUser)
                        {
                            <a asp-action="Delete" asp-route-id="@user.Id" class="btn" style="font-size:12px; font-weight:600; padding:6px 12px; border:1px solid var(--line); color:#B3261E;">Sil</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
