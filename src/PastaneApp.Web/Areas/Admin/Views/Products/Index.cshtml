@using PastaneApp.Core.Enums
@model IEnumerable<Product>

@{
    ViewData["Title"] = "Ürünler";
}

<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:32px;">
    <h1 class="as-serif" style="font-size:28px; font-weight:700; margin:0;">Ürünler</h1>
    <a asp-action="Create" class="as-pill" style="background:var(--turquoise); color:var(--turquoise-deep); font-weight:700;">+ Yeni Ürün</a>
</div>

<div style="background:#fff; border:1px solid var(--line); box-shadow:0 2px 14px rgba(61,43,28,.06);">
    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr style="background:var(--cream);">
                <th style="padding:14px 16px;"></th>
                <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:14px 16px;">Ad</th>
                <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:14px 16px;">Kategori</th>
                <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:14px 16px;">Fiyat</th>
                <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:14px 16px;">Stok</th>
                <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:14px 16px;">Durum</th>
                <th style="padding:14px 16px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                var thumb = product.Images.Where(i => i.ImageType == ImageType.Finished).OrderBy(i => i.SortOrder).Select(i => i.ImageUrl).FirstOrDefault();
                <tr>
                    <td style="padding:14px 16px; border-top:1px solid var(--line); width:56px;">
                        <div style="width:40px; height:40px; background:var(--beige); border-radius:3px; overflow:hidden;">
                            @if (thumb != null)
                            {
                                <img src="@thumb" style="width:100%; height:100%; object-fit:cover;" alt="" />
                            }
                        </div>
                    </td>
                    <td class="as-serif" style="padding:14px 16px; border-top:1px solid var(--line); font-size:14px; font-weight:700;">@product.Name</td>
                    <td style="padding:14px 16px; border-top:1px solid var(--line); font-size:14px; color:var(--ink-soft);">@product.Category?.Name</td>
                    <td style="padding:14px 16px; border-top:1px solid var(--line); font-size:14px;">@product.Price.ToString("C2")</td>
                    <td style="padding:14px 16px; border-top:1px solid var(--line); font-size:14px;">@product.Stock</td>
                    <td style="padding:14px 16px; border-top:1px solid var(--line);">
                        @if (product.IsActive)
                        {
                            <span style="display:inline-flex; font-size:12px; font-weight:600; padding:5px 12px; background:var(--ok-bg); color:var(--ok);">Aktif</span>
                        }
                        else
                        {
                            <span style="display:inline-flex; font-size:12px; font-weight:600; padding:5px 12px; background:var(--off-bg); color:var(--off);">Pasif</span>
                        }
                    </td>
                    <td style="padding:14px 16px; border-top:1px solid var(--line); text-align:right; white-space:nowrap;">
                        <a asp-controller="ProductManage" asp-action="Manage" asp-route-id="@product.Id" class="btn" style="font-size:12px; font-weight:600; padding:6px 12px; border:1px solid var(--line);">Detaylar</a>
                        <a asp-action="Edit" asp-route-id="@product.Id" class="btn" style="font-size:12px; font-weight:600; padding:6px 12px; border:1px solid var(--line);">Düzenle</a>
                        <a asp-action="Delete" asp-route-id="@product.Id" class="btn" style="font-size:12px; font-weight:600; padding:6px 12px; border:1px solid var(--line); color:#B3261E;">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
