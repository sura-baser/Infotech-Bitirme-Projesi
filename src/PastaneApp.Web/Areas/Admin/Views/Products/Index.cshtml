@model IEnumerable<Product>

@{
    ViewData["Title"] = "Ürünler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Ürünler</h1>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Ürün</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Ad</th>
            <th>Kategori</th>
            <th>Fiyat</th>
            <th>Stok</th>
            <th>Aktif</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Category?.Name</td>
                <td>@product.Price.ToString("C2")</td>
                <td>@product.Stock</td>
                <td>@(product.IsActive ? "Evet" : "Hayır")</td>
                <td class="text-end">
                    <a asp-controller="ProductManage" asp-action="Manage" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Detaylar</a>
                    <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
