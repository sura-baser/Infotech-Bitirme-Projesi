@model ProductViewModel

@{
    ViewData["Title"] = "Ürün Düzenle";
}

<h1 class="as-serif" style="font-size:28px; font-weight:700; margin:0 0 28px;">Ürün Düzenle</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" style="max-width:520px;">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" style="color:#B3261E; margin-bottom:16px;"></div>

    <div style="margin-bottom:20px;">
        <label asp-for="Name" style="display:block; font-size:14px; margin-bottom:8px;"></label>
        <input asp-for="Name" style="width:100%; padding:12px 16px; border:1px solid var(--line); background:#fff; font-size:14px;" />
        <span asp-validation-for="Name" style="color:#B3261E; font-size:13px;"></span>
    </div>

    <div style="margin-bottom:20px;">
        <label asp-for="Description" style="display:block; font-size:14px; margin-bottom:8px;"></label>
        <textarea asp-for="Description" rows="3" style="width:100%; padding:12px 16px; border:1px solid var(--line); background:#fff; font-size:14px; font-family:inherit;"></textarea>
        <span asp-validation-for="Description" style="color:#B3261E; font-size:13px;"></span>
    </div>

    <div style="margin-bottom:20px;">
        <label asp-for="CategoryId" style="display:block; font-size:14px; margin-bottom:8px;"></label>
        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select" style="border-radius:0; border-color:var(--line);">
            <option value="">-- Kategori Seçin --</option>
        </select>
        <span asp-validation-for="CategoryId" style="color:#B3261E; font-size:13px;"></span>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px;">
        <div>
            <label asp-for="Price" style="display:block; font-size:14px; margin-bottom:8px;"></label>
            <input asp-for="Price" style="width:100%; padding:12px 16px; border:1px solid var(--line); background:#fff; font-size:14px;" />
            <span asp-validation-for="Price" style="color:#B3261E; font-size:13px;"></span>
        </div>
        <div>
            <label asp-for="Stock" style="display:block; font-size:14px; margin-bottom:8px;"></label>
            <input asp-for="Stock" style="width:100%; padding:12px 16px; border:1px solid var(--line); background:#fff; font-size:14px;" />
            <span asp-validation-for="Stock" style="color:#B3261E; font-size:13px;"></span>
        </div>
    </div>

    <div style="margin-bottom:20px;">
        <label asp-for="ServingInfo" style="display:block; font-size:14px; margin-bottom:8px;"></label>
        <input asp-for="ServingInfo" placeholder="Örn: 6 kişilik" style="width:100%; padding:12px 16px; border:1px solid var(--line); background:#fff; font-size:14px;" />
        <span asp-validation-for="ServingInfo" style="color:#B3261E; font-size:13px;"></span>
    </div>

    <label style="display:flex; align-items:center; gap:9px; font-size:14px; color:var(--ink-soft); margin-bottom:28px; cursor:pointer;">
        <input asp-for="IsActive" style="accent-color:var(--ink); width:15px; height:15px;" />
        @Html.DisplayNameFor(m => m.IsActive)
    </label>

    <div style="display:flex; align-items:center; gap:16px;">
        <button type="submit" class="as-pill">Kaydet</button>
        <a asp-action="Index" style="font-size:14px; color:var(--ink-soft);">İptal</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
