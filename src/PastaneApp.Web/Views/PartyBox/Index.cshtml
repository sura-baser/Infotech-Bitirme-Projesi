@model PartyBoxIndexViewModel
@using PastaneApp.Web.Models.PartyBox

@{
    ViewData["Title"] = "Parti Kutunu Kendin Oluştur";
}

<div style="background:var(--bordo); color:var(--cream);">
    <div class="as-party-hero">
        <div style="font-size:13px; letter-spacing:.16em; text-transform:uppercase; font-weight:600; margin-bottom:16px; opacity:.85;">Özel Karışım</div>
        <h1 class="as-serif as-party-title" style="font-weight:700; margin:0 0 20px;">Parti Kutunu Kendin Oluştur!</h1>
        <p style="font-size:16px; line-height:1.7; max-width:560px; opacity:.9; margin:0;">Bir kutu boyutu seç, sonra sevdiğin lezzetlerden karıştırarak kutunu doldur.</p>
    </div>
</div>

@if (!Model.Sizes.Any() || !Model.Flavors.Any())
{
    <div style="max-width:1280px; margin:0 auto; padding:64px 24px; text-align:center;">
        <p style="color:var(--ink-soft); font-size:16px;">Bu özellik üzerinde çalışıyoruz. Şimdilik <a asp-controller="Products" asp-action="Index">ürünlerimize</a> göz atabilirsin.</p>
    </div>
}
else
{
    <form asp-controller="Cart" asp-action="AddPartyBox" method="post" id="party-box-form">
        <div style="max-width:1280px; margin:0 auto; padding:48px 24px 90px;">

            <div style="font-size:13px; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-soft); font-weight:600; margin-bottom:18px;">1. Kutu Boyutu Seç</div>
            <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 260px)); gap:20px; margin-bottom:48px;">
                @for (var i = 0; i < Model.Sizes.Count; i++)
                {
                    var size = Model.Sizes[i];
                    <label class="as-chip size-option" data-piece-count="@size.PieceCount" style="cursor:pointer; flex-direction:column; align-items:flex-start; gap:8px; padding:20px; border:1px solid var(--line);">
                        <input type="radio" name="boxProductId" value="@size.ProductId" data-piece-count="@size.PieceCount" @(i == 0 ? "checked" : "") style="accent-color:var(--bordo);" />
                        <div class="as-serif" style="font-size:19px; font-weight:700; color:var(--ink);">@size.Name</div>
                        <div style="font-size:13px; color:var(--ink-soft);">@size.PieceCount parça</div>
                        <div style="font-size:16px; font-weight:600; color:var(--ink);">@size.Price.ToTl()</div>
                    </label>
                }
            </div>

            <div style="font-size:13px; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-soft); font-weight:600; margin-bottom:18px;">2. Lezzetlerini Seç</div>
            <div class="as-flavor-grid" style="margin-bottom:28px;">
                @foreach (var flavor in Model.Flavors)
                {
                    <div style="border:1px solid var(--line); padding:16px;">
                        <div class="as-tile" style="margin-bottom:12px;">
                            @if (flavor.ImageUrl != null)
                            {
                                <img src="@flavor.ImageUrl" style="width:100%; height:100%; object-fit:cover;" alt="@flavor.Label" />
                            }
                        </div>
                        <div style="font-size:14px; font-weight:600; margin-bottom:10px;">@flavor.Label</div>
                        <input type="number" class="flavor-quantity" name="quantities[@flavor.Label]" value="0" min="0" style="width:100%; padding:10px; border:1px solid var(--line); text-align:center;" />
                    </div>
                }
            </div>

            <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:20px; padding:20px 0; border-top:1px solid var(--line);">
                <div id="party-box-counter" style="font-size:15px; font-weight:600;">Seçilen: 0 / <span id="target-piece-count">@Model.Sizes.First().PieceCount</span> parça</div>
                <button type="submit" id="party-box-submit" class="as-pill as-pill-bordo" disabled style="opacity:.5; cursor:not-allowed;">Sepete Ekle</button>
            </div>
        </div>
    </form>
}

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('party-box-form');
            if (!form) return;

            var sizeInputs = form.querySelectorAll('input[name="boxProductId"]');
            var quantityInputs = form.querySelectorAll('.flavor-quantity');
            var counterEl = document.getElementById('party-box-counter');
            var targetEl = document.getElementById('target-piece-count');
            var submitBtn = document.getElementById('party-box-submit');

            function getTargetCount() {
                var checked = form.querySelector('input[name="boxProductId"]:checked');
                return checked ? parseInt(checked.dataset.pieceCount, 10) : 0;
            }

            function update() {
                var target = getTargetCount();
                var total = 0;
                quantityInputs.forEach(function (input) {
                    var v = parseInt(input.value, 10);
                    if (!isNaN(v) && v > 0) total += v;
                });

                targetEl.textContent = target;
                counterEl.firstChild.textContent = 'Seçilen: ' + total + ' / ';

                var matches = total === target && target > 0;
                submitBtn.disabled = !matches;
                submitBtn.style.opacity = matches ? '1' : '.5';
                submitBtn.style.cursor = matches ? 'pointer' : 'not-allowed';
            }

            sizeInputs.forEach(function (input) { input.addEventListener('change', update); });
            quantityInputs.forEach(function (input) { input.addEventListener('input', update); });

            update();
        })();
    </script>
}
