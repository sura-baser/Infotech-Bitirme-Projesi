@model HomeIndexViewModel

@{
    ViewData["Title"] = "Anasayfa";
}

<!-- hero -->
<div style="max-width:1280px; margin:0 auto; padding:24px 24px 90px; display:grid; grid-template-columns:1fr 1fr; gap:72px; align-items:center;">
    <div>
        <div style="font-size:13px; letter-spacing:.16em; text-transform:uppercase; color:var(--accent-deep); font-weight:600; margin-bottom:20px;">El Yapımı · Günlük Taze</div>
        <h1 class="as-serif" style="font-size:56px; line-height:1.08; font-weight:700; margin:0 0 26px;">Atölyeden Sofranıza,<br />Zarafetle</h1>
        <p style="font-size:17px; line-height:1.7; color:var(--ink-soft); max-width:460px; margin:0 0 36px;">Görsel zarafet, dengeli katmanlar. En taze mevsim lezzetleriyle, özel anlarınıza eşlik etmesi için sayılı adette hazırlanan imza tatlar.</p>
        <div style="display:flex; flex-wrap:wrap; gap:16px;">
            <a asp-controller="Products" asp-action="Index" class="as-pill">Ürünleri Keşfet</a>
            <a asp-controller="PartyBox" asp-action="Index" class="as-pill as-pill-bordo">Parti Kutunu Kendin Oluştur!</a>
        </div>
    </div>
    <div class="as-tile">
        <img src="~/images/products/hero-san-sebastian.jpg" alt="El yapımı San Sebastian" style="width:100%; height:100%; object-fit:cover;" />
    </div>
</div>

<!-- categories : single deliberate color band -->
<div style="background:var(--butter);">
    <div style="max-width:1280px; margin:0 auto; padding:36px 24px 48px;">
        <h2 class="as-serif" style="font-size:24px; font-weight:700; margin:0 0 24px;">Kategoriler</h2>
        <div style="display:grid; grid-template-columns:repeat(6, 1fr); gap:24px;">
            @foreach (var category in Model.Categories)
            {
                <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@category.Id" class="category-card" style="text-decoration:none; color:inherit; display:flex; flex-direction:column; align-items:center; gap:14px;">
                    <div class="as-tile" style="background:var(--cream);">
                        @if (category.ImageUrl != null)
                        {
                            <img src="@category.ImageUrl" style="width:100%; height:100%; object-fit:cover;" alt="@category.Name" />
                        }
                    </div>
                    <div style="font-size:14px; font-weight:600;">@category.Name</div>
                </a>
            }
        </div>
    </div>
</div>

<!-- trust -->
<div style="background:var(--ink); color:var(--cream);">
    <div style="max-width:1280px; margin:0 auto; padding:76px 24px; display:grid; grid-template-columns:repeat(3,1fr); gap:56px;">
        <div>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" style="margin-bottom:18px;"><path d="M12 2L14.5 8.5L21 9.3L16 13.9L17.5 20.5L12 17L6.5 20.5L8 13.9L3 9.3L9.5 8.5L12 2Z" stroke="#EAE0CC" stroke-width="1.4" stroke-linejoin="round" /></svg>
            <h3 class="as-serif" style="font-size:21px; font-weight:700; margin:0 0 10px;">Elde Yapılır</h3>
            <p style="font-size:15px; line-height:1.7; color:#C9B8A0; margin:0;">Her sipariş küçük partiler halinde, tek tek elle hazırlanır — seri üretim yok.</p>
        </div>
        <div>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" style="margin-bottom:18px;"><path d="M12 3L3 7.5V12C3 16.5 6.8 20.6 12 22C17.2 20.6 21 16.5 21 12V7.5L12 3Z" stroke="#EAE0CC" stroke-width="1.4" stroke-linejoin="round" /><path d="M8.5 12L11 14.5L16 9.5" stroke="#EAE0CC" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <h3 class="as-serif" style="font-size:21px; font-weight:700; margin:0 0 10px;">Şeffaf Malzeme</h3>
            <p style="font-size:15px; line-height:1.7; color:#C9B8A0; margin:0;">Her üründe kullanılan malzemeler ve alerjenler açıkça, ürün sayfasında gösterilir.</p>
        </div>
        <div>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" style="margin-bottom:18px;"><circle cx="12" cy="12" r="9" stroke="#EAE0CC" stroke-width="1.4" /><path d="M12 7V12L15.5 14" stroke="#EAE0CC" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <h3 class="as-serif" style="font-size:21px; font-weight:700; margin:0 0 10px;">Günlük Taze</h3>
            <p style="font-size:15px; line-height:1.7; color:#C9B8A0; margin:0;">Siparişler teslimattan kısa süre önce hazırlanır, gün beklemez.</p>
        </div>
    </div>
</div>

<!-- featured products -->
<div style="max-width:1280px; margin:0 auto; padding:84px 24px;">
    <div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:36px;">
        <h2 class="as-serif" style="font-size:28px; font-weight:700; margin:0;">Bu Haftanın Öne Çıkanları</h2>
        <a asp-controller="Products" asp-action="Index" style="font-size:14px; font-weight:600; letter-spacing:.04em;">Tümünü Gör &rarr;</a>
    </div>

    @if (!Model.FeaturedProducts.Any())
    {
        <p style="color:var(--ink-soft);">Henüz ürün eklenmedi.</p>
    }
    else
    {
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 340px)); gap:32px;">
            @foreach (var product in Model.FeaturedProducts)
            {
                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" style="text-decoration:none; color:inherit;">
                    <div class="as-tile" style="margin-bottom:18px;">
                        @if (product.ImageUrl != null)
                        {
                            <img src="@product.ImageUrl" style="width:100%; height:100%; object-fit:cover;" alt="@product.Name" />
                        }
                        else
                        {
                            <div class="as-tile-placeholder">fotoğraf</div>
                        }
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                        <div>
                            <div class="as-serif" style="font-size:18px; font-weight:700;">@product.Name</div>
                            <div style="font-size:13px; color:var(--ink-soft); margin-top:2px;">@product.CategoryName</div>
                        </div>
                        <div style="font-size:16px; font-weight:600;">@product.Price.ToString("C2")</div>
                    </div>
                </a>
            }
        </div>
    }
</div>
