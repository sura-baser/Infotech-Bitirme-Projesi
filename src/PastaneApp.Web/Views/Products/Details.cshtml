@using PastaneApp.Core.Enums
@model ProductDetailViewModel

@{
    ViewData["Title"] = Model.Product.Name;
    var finishedImages = Model.Product.Images
        .Where(i => i.ImageType == ImageType.Finished)
        .OrderBy(i => i.SortOrder)
        .ToList();
    var finishedImage = finishedImages.FirstOrDefault();
    var hasFlavorOptions = finishedImages.Count > 1;
    var ingredientsImage = Model.Product.Images
        .Where(i => i.ImageType == ImageType.Ingredients)
        .OrderBy(i => i.SortOrder)
        .FirstOrDefault();
    var processImage = Model.Product.Images
        .Where(i => i.ImageType == ImageType.Process)
        .OrderBy(i => i.SortOrder)
        .FirstOrDefault();
    var hasReveal = ingredientsImage != null && processImage != null;
    var ingredientsText = string.Join(", ", Model.Product.Ingredients.OrderBy(i => i.SortOrder).Select(i => i.Name));
}

<div style="max-width:1280px; margin:0 auto; padding:12px 24px 20px; font-size:13px; color:var(--ink-soft);">
    <a asp-action="Index">Ürünler</a> &nbsp;/&nbsp; @Model.Product.Category?.Name &nbsp;/&nbsp; @Model.Product.Name
</div>

<div style="max-width:1280px; margin:0 auto; padding:0 24px 90px; display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:start;">

    <!-- photo column -->
    <div>
        @if (finishedImage == null && ingredientsImage == null)
        {
            <div class="as-tile">
                <div class="as-tile-placeholder">ürün fotoğrafı</div>
            </div>
        }
        else
        {
            @if (finishedImage != null)
            {
                <div class="as-tile" style="margin-bottom:16px;">
                    <img id="main-product-image" src="@finishedImage.ImageUrl" style="width:100%; height:100%; object-fit:cover;" alt="@Model.Product.Name" />
                </div>
            }

            @if (hasFlavorOptions)
            {
                <div style="display:flex; flex-wrap:wrap; gap:10px; margin-bottom:16px;">
                    @foreach (var image in finishedImages)
                    {
                        <button type="button" class="as-chip flavor-option @(image == finishedImage ? "active" : "")" data-image-url="@image.ImageUrl" style="cursor:pointer; background:none; @(image == finishedImage ? "border-color:var(--ink); color:var(--ink); font-weight:600;" : "")">
                            @(string.IsNullOrWhiteSpace(image.Label) ? "Seçenek" : image.Label)
                        </button>
                    }
                </div>
            }

            @if (ingredientsImage != null)
            {
                @if (hasReveal)
                {
                    <div class="reveal-container as-tile" style="position:relative; overflow:hidden; cursor:pointer;">
                        <img src="@ingredientsImage.ImageUrl" style="width:100%; height:100%; object-fit:cover;" alt="İçindekiler" />
                        <img src="@processImage!.ImageUrl" class="reveal-overlay" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0; transition:opacity .6s ease;" alt="Oluşum" />
                        <div class="reveal-label" data-initial-text="@(Model.Product.Name) — dokunun, oluşumunu görün!" style="position:absolute; left:50%; bottom:18px; transform:translateX(-50%); background:rgba(255,255,255,.22); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px); border:1px solid rgba(255,255,255,.4); color:#fff; padding:11px 22px; font-size:13px; font-weight:600; letter-spacing:.02em; white-space:nowrap; pointer-events:none;">@(Model.Product.Name) — dokunun, oluşumunu görün!</div>
                    </div>
                }
                else
                {
                    <div class="as-tile">
                        <img src="@ingredientsImage.ImageUrl" style="width:100%; height:100%; object-fit:cover;" alt="İçindekiler" />
                    </div>
                }
            }
        }
    </div>

    <!-- info column -->
    <div>
        <h1 class="as-serif" style="font-size:38px; font-weight:700; margin:0 0 8px;">@Model.Product.Name</h1>
        <div style="color:var(--ink-soft); font-size:14px; margin-bottom:18px;">
            @Model.Product.Category?.Name
            @if (!string.IsNullOrWhiteSpace(Model.Product.ServingInfo))
            {
                <text> · @Model.Product.ServingInfo</text>
            }
        </div>
        <div style="font-size:24px; font-weight:600; margin-bottom:26px;">@Model.Product.Price.ToString("C2")</div>

        @if (!string.IsNullOrWhiteSpace(Model.Product.Description))
        {
            <p style="font-size:16px; line-height:1.75; color:var(--ink-soft); margin:0 0 @(string.IsNullOrWhiteSpace(Model.Product.Highlights) ? "28px" : "14px");">@Model.Product.Description</p>
        }

        @{
            var highlights = (Model.Product.Highlights ?? string.Empty)
                .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList();
        }
        @if (highlights.Any())
        {
            <ul style="font-size:15px; line-height:1.8; color:var(--ink-soft); margin:0 0 28px; padding-left:20px;">
                @foreach (var highlight in highlights)
                {
                    <li>@highlight</li>
                }
            </ul>
        }

        @if (Model.AllergenNames.Any())
        {
            <div style="margin-bottom:26px;">
                <div style="font-size:13px; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-soft); font-weight:600; margin-bottom:12px;">Alerjen Bilgisi</div>
                <div style="display:flex; flex-wrap:wrap; gap:10px;">
                    @foreach (var allergenName in Model.AllergenNames)
                    {
                        <span class="as-chip">@allergenName</span>
                    }
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(ingredientsText))
        {
            <div style="margin-bottom:34px;">
                <div style="font-size:13px; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-soft); font-weight:600; margin-bottom:12px;">İçindekiler</div>
                <div style="font-size:15px; color:var(--ink-soft); line-height:1.8;">@ingredientsText</div>
            </div>
        }

        <form asp-controller="Cart" asp-action="AddToCart" method="post">
            <input type="hidden" name="productId" value="@Model.Product.Id" />
            <div style="display:flex; align-items:center; gap:14px;">
                <input type="number" name="quantity" value="1" min="1" style="width:80px; padding:12px; border:1px solid var(--line); text-align:center;" />
                <button type="submit" class="as-pill" style="flex:1;">Sepete Ekle</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.reveal-container').forEach(function (container) {
            container.addEventListener('click', function () {
                var overlay = container.querySelector('.reveal-overlay');
                var label = container.querySelector('.reveal-label');
                var revealed = overlay.style.opacity === '1';
                overlay.style.opacity = revealed ? '0' : '1';
                label.textContent = revealed ? label.dataset.initialText : 'Tekrar Dokunun';
            });
        });

        document.querySelectorAll('.flavor-option').forEach(function (button) {
            button.addEventListener('click', function () {
                var mainImage = document.getElementById('main-product-image');
                if (mainImage) {
                    mainImage.src = button.dataset.imageUrl;
                }
                document.querySelectorAll('.flavor-option').forEach(function (btn) {
                    btn.classList.remove('active');
                    btn.style.borderColor = '';
                    btn.style.color = '';
                    btn.style.fontWeight = '';
                });
                button.classList.add('active');
                button.style.borderColor = 'var(--ink)';
                button.style.color = 'var(--ink)';
                button.style.fontWeight = '600';
            });
        });
    </script>
}
