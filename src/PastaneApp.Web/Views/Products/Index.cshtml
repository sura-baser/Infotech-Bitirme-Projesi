@model ProductListViewModel

@{
    ViewData["Title"] = "Ürünler";
}

<div style="max-width:1280px; margin:0 auto; padding:28px 24px 12px;">
    <h1 class="as-serif" style="font-size:40px; font-weight:700; margin:0;">Ürünlerimiz</h1>
</div>

<div style="max-width:1280px; margin:0 auto; padding:20px 24px 90px; display:grid; grid-template-columns:260px 1fr; gap:56px; align-items:start;">

    <!-- filter sidebar -->
    <form method="get" asp-action="Index" style="display:flex; flex-direction:column; gap:30px;">
        <div>
            <div style="font-size:13px; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:12px; font-weight:600;">Ara</div>
            <input type="text" name="search" value="@Model.Search" placeholder="Ürün ara..." style="width:100%; padding:12px 16px; border:1px solid var(--line); background:#fff; font-size:14px;" />
        </div>

        <div>
            <div style="font-size:13px; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:12px; font-weight:600;">Kategori</div>
            <select name="categoryId" class="form-select" asp-items="Model.Categories" style="border-radius:0; border-color:var(--line);">
                <option value="">Tüm Kategoriler</option>
            </select>
        </div>

        @if (Model.AllAllergens.Any())
        {
            <div>
                <div style="font-size:13px; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:12px; font-weight:600;">Alerjen İçermesin</div>
                <div style="display:flex; flex-direction:column; gap:10px;">
                    @foreach (var allergen in Model.AllAllergens)
                    {
                        <label style="display:flex; align-items:center; gap:9px; font-size:14px; color:var(--ink-soft); cursor:pointer;">
                            <input type="checkbox" name="excludeAllergenIds" value="@allergen.Id" checked="@Model.ExcludedAllergenIds.Contains(allergen.Id)" style="accent-color:var(--ink); width:15px; height:15px;" />
                            @allergen.Name
                        </label>
                    }
                </div>
            </div>
        }

        <button type="submit" class="as-pill">Filtrele</button>
        <a asp-action="Index" style="font-size:13px; color:var(--ink-soft); text-decoration:underline; text-align:center;">Filtreleri Temizle</a>
    </form>

    <!-- product grid -->
    <div>
        @if (!Model.Products.Any())
        {
            <p style="color:var(--ink-soft);">Aradığınız kriterlere uygun ürün bulunamadı.</p>
        }

        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(200px, 260px)); gap:32px 28px;">
            @foreach (var product in Model.Products)
            {
                <a asp-action="Details" asp-route-id="@product.Id" style="text-decoration:none; color:inherit;">
                    <div class="as-tile" style="margin-bottom:16px;">
                        @if (product.ImageUrl != null)
                        {
                            <img src="@product.ImageUrl" style="width:100%; height:100%; object-fit:cover;" alt="@product.Name" />
                        }
                        else
                        {
                            <div class="as-tile-placeholder">fotoğraf</div>
                        }
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                        <div>
                            <div class="as-serif" style="font-size:16px; font-weight:700;">@product.Name</div>
                            <div style="font-size:12px; color:var(--ink-soft); margin-top:2px;">@product.CategoryName</div>
                        </div>
                        <div style="font-size:15px; font-weight:600;">@product.Price.ToString("C2")</div>
                    </div>
                </a>
            }
        </div>
    </div>
</div>
