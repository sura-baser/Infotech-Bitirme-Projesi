@model CheckoutViewModel

@{
    ViewData["Title"] = "Siparişi Tamamla";
}

<div style="max-width:640px; margin:0 auto; padding:40px 24px 90px;">
    <h1 class="as-serif" style="font-size:34px; font-weight:700; margin:0 0 32px;">Siparişi Tamamla</h1>

    <form asp-action="Checkout" method="post">
        <div asp-validation-summary="ModelOnly" style="color:#B3261E; margin-bottom:16px;"></div>

        <div style="font-size:13px; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-soft); font-weight:600; margin-bottom:16px;">Teslimat Bilgileri</div>

        <div style="margin-bottom:20px;">
            <label asp-for="DeliveryAddress" style="display:block; font-size:14px; margin-bottom:8px;"></label>
            <textarea asp-for="DeliveryAddress" rows="3" style="width:100%; padding:12px 16px; border:1px solid var(--line); background:#fff; font-size:14px; font-family:inherit;"></textarea>
            <span asp-validation-for="DeliveryAddress" style="color:#B3261E; font-size:13px;"></span>
        </div>

        <div class="as-form-row" style="margin-bottom:32px;">
            <div>
                <label asp-for="DeliveryCity" style="display:block; font-size:14px; margin-bottom:8px;"></label>
                <input asp-for="DeliveryCity" style="width:100%; padding:12px 16px; border:1px solid var(--line); background:#fff; font-size:14px;" />
                <span asp-validation-for="DeliveryCity" style="color:#B3261E; font-size:13px;"></span>
            </div>
            <div>
                <label asp-for="PhoneNumber" style="display:block; font-size:14px; margin-bottom:8px;"></label>
                <input asp-for="PhoneNumber" style="width:100%; padding:12px 16px; border:1px solid var(--line); background:#fff; font-size:14px;" />
                <span asp-validation-for="PhoneNumber" style="color:#B3261E; font-size:13px;"></span>
            </div>
        </div>

        <p style="font-size:13px; color:var(--ink-soft); margin:0 0 24px; line-height:1.6;">Ödemeyi bir sonraki adımda iyzico güvenli ödeme sayfasında yapacaksınız. Kart bilgileriniz bu sitede saklanmaz.</p>

        <div style="display:flex; align-items:center; gap:16px;">
            <button type="submit" class="as-pill">Ödemeye Geç</button>
            <a asp-controller="Cart" asp-action="Index" style="font-size:14px; color:var(--ink-soft);">İptal</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
