@using PastaneApp.Web.Helpers
@model Order

@{
    ViewData["Title"] = $"Sipariş #{Model.Id}";
}

<div style="max-width:960px; margin:0 auto; padding:40px 24px 90px;">
    <h1 class="as-serif" style="font-size:34px; font-weight:700; margin:0 0 24px;">Sipariş #@Model.Id</h1>

    <div style="display:flex; flex-wrap:wrap; gap:32px; margin-bottom:36px; font-size:14px; color:var(--ink-soft);">
        <div><strong style="color:var(--ink);">Tarih:</strong> @Model.OrderDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
        <div><strong style="color:var(--ink);">Durum:</strong> @OrderStatusHelper.GetDisplayName(Model.Status)</div>
        <div><strong style="color:var(--ink);">Teslimat Adresi:</strong> @Model.DeliveryAddress</div>
        <div><strong style="color:var(--ink);">Telefon:</strong> @Model.PhoneNumber</div>
    </div>

    <table style="width:100%; border-collapse:collapse; margin-bottom:24px;">
        <thead>
            <tr>
                <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:0 16px 12px 0; border-bottom:1px solid var(--line);">Ürün</th>
                <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:0 16px 12px; border-bottom:1px solid var(--line);">Birim Fiyat</th>
                <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:0 16px 12px; border-bottom:1px solid var(--line);">Adet</th>
                <th style="text-align:left; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); padding:0 16px 12px; border-bottom:1px solid var(--line);">Ara Toplam</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderDetails)
            {
                <tr>
                    <td style="padding:16px 16px 16px 0; border-bottom:1px solid var(--line); font-size:14px;">
                        @item.ProductName
                        @if (!string.IsNullOrWhiteSpace(item.CustomizationNotes))
                        {
                            <div style="font-size:12px; color:var(--ink-soft); margin-top:4px;">@item.CustomizationNotes</div>
                        }
                    </td>
                    <td style="padding:16px; border-bottom:1px solid var(--line); font-size:14px;">@item.UnitPrice.ToString("C2")</td>
                    <td style="padding:16px; border-bottom:1px solid var(--line); font-size:14px;">@item.Quantity</td>
                    <td style="padding:16px; border-bottom:1px solid var(--line); font-size:14px; font-weight:600;">@((item.UnitPrice * item.Quantity).ToString("C2"))</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" style="padding:16px 16px 16px 0; text-align:right; font-weight:600;">Toplam</td>
                <td style="padding:16px; font-weight:700; font-size:16px;">@Model.TotalAmount.ToString("C2")</td>
            </tr>
        </tfoot>
    </table>

    <a asp-action="Index" style="font-size:14px; font-weight:600;">&larr; Siparişlerime Dön</a>
</div>
