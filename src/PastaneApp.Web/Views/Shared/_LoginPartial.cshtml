@using Microsoft.AspNetCore.Identity
@using PastaneApp.Core.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item">
                <a class="nav-link as-nav-link" asp-area="Admin" asp-controller="Categories" asp-action="Index">Admin Paneli</a>
            </li>
        }
        var currentUser = await UserManager.GetUserAsync(User);
        var displayName = !string.IsNullOrWhiteSpace(currentUser?.FullName) ? currentUser.FullName : User.Identity!.Name;
        <li class="nav-item d-flex align-items-center">
            <span class="nav-link as-nav-link" style="color:var(--accent-deep); padding-right:8px;">Merhaba</span>
            <span style="background:var(--butter); color:var(--ink); font-weight:600; font-size:14px; padding:5px 12px;">@displayName!</span>
        </li>
        <li class="nav-item">
            <a class="nav-link as-nav-link" asp-area="" asp-controller="Account" asp-action="Profile">Profilim</a>
        </li>
        <li class="nav-item">
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-link nav-link as-nav-link">Çıkış Yap</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link as-nav-link" asp-area="" asp-controller="Account" asp-action="Login">Giriş Yap</a>
        </li>
        <li class="nav-item">
            <a class="nav-link as-nav-link" asp-area="" asp-controller="Account" asp-action="Register">Kayıt Ol</a>
        </li>
    }
</ul>
